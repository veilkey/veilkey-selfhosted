# Docker image tag (default: dev)
IMAGE_TAG=dev

# Docker registry mirror prefix, e.g. "mirror.example.com/" (default: empty)
DOCKER_MIRROR=

# Host ports (change if conflicts with existing services)
VAULTCENTER_HOST_PORT=11181
LOCALVAULT_HOST_PORT=11180
VAULTCENTER_P2P_PORT=26656
VAULTCENTER_RPC_PORT=26657

# No trusted-IP bypass by default. For a separate LocalVault, specify only the
# VaultCenter's exact source address, never private-network ranges or loopback.
VEILKEY_TRUSTED_IPS=

# VaultCenter
VAULTCENTER_AUTO_COMPLETE_INSTALL_FLOW=0
VEILKEY_AGENT_SCHEME=https

# Data directories (host paths, default: ./data/<service>)
# VAULTCENTER_DATA_DIR=./data/vaultcenter
# LOCALVAULT_DATA_DIR=./data/localvault

# LocalVault
LOCALVAULT_LABEL=localvault-01
# CometBFT persistent peers (set after vaultcenter starts — nodeID@host:port)
LOCALVAULT_CHAIN_PEERS=

# veil CLI container: host directory to mount as /host (default: /Users for macOS)
# Linux: set to /home or /root
# VEIL_WORK_DIR=/home

# Never put master passwords or password-file paths in this file.
# Unlock VaultCenter interactively after restart; LocalVault uses VC-managed unlock.
# The bundled Compose TLS exception is single-host Docker-internal only.
# For host/remote clients, provision CA trust as described in docs/setup/tls.md.
