# VeilKey LocalVault Configuration
# Copy to .env and adjust values
# All variables marked (required) must be set — the server will not start without them.

# --- Database ---
# (required) Path to the SQLite database file
VEILKEY_DB_PATH=/opt/veilkey-localvault/data/veilkey.db

# --- Network ---
# (required) Listen address
VEILKEY_ADDR=:10180

# No trusted-IP bypass by default. If needed, set only the VaultCenter's exact
# source address; never use private-network ranges or loopback defaults.
VEILKEY_TRUSTED_IPS=

# --- Unlock ---
# LocalVault uses VaultCenter-managed unlock. Do not store a master password or
# a master-password file path here; unlock VaultCenter interactively after restart.
# VEILKEY_PASSWORD_FILE is unsupported and must not be set.

# --- HTTP Client ---
# Timeout for outgoing HTTP requests (e.g. token validation)
# VEILKEY_HTTP_TIMEOUT=10s

# --- Heartbeat ---
# Interval for sending heartbeats to vaultcenter (e.g. "5m", "1m"). Default: 5m
# VEILKEY_HEARTBEAT_INTERVAL=5m

# --- Deployment Mode ---
# (required) "root" for standalone, "child" for registration under a vaultcenter
VEILKEY_MODE=root

# (required for child mode) URL of the parent vaultcenter
# VEILKEY_PARENT_URL=http://vaultcenter:10181

# (required for child mode) Human-readable label for this localvault node
# VEILKEY_LABEL=localvault-01

# --- VaultCenter ---
# URL of the vaultcenter service this localvault reports to
# VEILKEY_VAULTCENTER_URL=https://your-vaultcenter:10180

# --- Identity ---
# Human-readable name for this vault node (defaults to hostname)
# VEILKEY_VAULT_NAME=my-vault

# --- TLS Configuration ---
# Certificate and key for HTTPS listener
# VEILKEY_TLS_CERT=/etc/veilkey/tls/server.crt
# VEILKEY_TLS_KEY=/etc/veilkey/tls/server.key
# Use the OS trust store, or a verified private CA bundle for outgoing HTTPS.
# SSL_CERT_FILE=/etc/veilkey/tls/ca.crt
# TLS verification is enabled. See docs/setup/tls.md for CA provisioning.
VEILKEY_TLS_INSECURE=0

# --- Database Encryption ---
# Optional SQLCipher passphrase. If set the binary must be built with CGO + SQLCipher.
# VEILKEY_DB_KEY=

# --- Managed Paths ---
# Comma-separated absolute paths that this agent manages (reported in heartbeats)
# VEILKEY_MANAGED_PATHS=/etc/veilkey,/opt/veilkey

# --- Heartbeat Context ---
# Path to a single YAML/JSON context file sent with each heartbeat
# VEILKEY_CONTEXT_FILE=/etc/veilkey/context.yaml
# Directory scanned for *.yaml/*.json context files (used when VEILKEY_CONTEXT_FILE is not set)
# VEILKEY_CONTEXT_DIR=/etc/veilkey/context.d

# --- CometBFT Chain ---
# Set to enable chain full node. Leave empty to disable.
# VEILKEY_CHAIN_HOME=
# Override RPC listen address (default: tcp://127.0.0.1:26657)
# VEILKEY_CHAIN_RPC_LISTEN=
# Override P2P listen address (default: tcp://0.0.0.0:26656)
# VEILKEY_CHAIN_P2P_LISTEN=
# Persistent peers for connecting to validator (format: nodeID@host:port)
# VEILKEY_CHAIN_PERSISTENT_PEERS=

# --- Registration ---
# One-time registration token from VaultCenter (consumed on first heartbeat)
# VEILKEY_REGISTRATION_TOKEN=
